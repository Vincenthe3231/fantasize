# Copy to .env.local (gitignored) or add to .env — then load in bash before running scripts:
#   bash -lc 'set -a && source .env && set +a && ./scripts/supabase-migrate/export-auth.sh'
# Fish does not load .env automatically; use bash -lc as above or: set -gx DATABASE_URL_SOURCE $SOURCE_DATABASE_SESSION_POOLER_URL
#
# URIs: Dashboard → Settings → Database → Session pooler (IPv4-friendly) or Direct.

# Option A — names used by pg_dump/psql in scripts (any Postgres URI):
export DATABASE_URL_SOURCE='postgresql://postgres.SOURCE_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres'
export DATABASE_URL_TARGET='postgresql://postgres.TARGET_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres'

# Option B — same URLs, Vite-style names (scripts resolve these if DATABASE_URL_* is empty):
# export SOURCE_DATABASE_SESSION_POOLER_URL='postgresql://...'
# export TARGET_DATABASE_SESSION_POOLER_URL='postgresql://...'
