# Copy to .env — never commit real values.
# Dashboard: Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional: dashboard project ref (URL path); keep in sync with VITE_SUPABASE_URL host.
# VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
# Anonymous (publishable) key — safe for browser apps. Do not use the service_role key here.
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_anon_key

# Storage: bucket name for Upload node (Supabase Dashboard → Storage). Public read + insert policies required for anon/auth.
VITE_SUPABASE_STORAGE_BUCKET=uploads

# --- One-off org migration (optional; use scripts/supabase-migrate + docs/supabase-migrate-between-projects.md) ---
# Postgres URIs from Dashboard → Settings → Database (not the anon key).
# DATABASE_URL_SOURCE=postgresql://postgres:...@db.OLD_REF.supabase.co:5432/postgres
# DATABASE_URL_TARGET=postgresql://postgres:...@db.NEW_REF.supabase.co:5432/postgres

# Edge Function `scout-execute` (Supabase Dashboard → Edge Functions → scout-execute → Secrets). Not used by Vite directly.
# OPENROUTER_API_KEY=
# Optional: override API host (default https://openrouter.ai/api/v1). Image gen uses direct fetch + lenient JSON parse.
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Stage 2 instructions (text prompt refinement): OPENROUTER_STAGE2_MODEL=google/gemini-2.0-flash-001
# Stage 2 image generator — default model when canvas mode is Auto (OpenRouter image modalities):
# OPENROUTER_IMAGE_GEN_MODEL=google/gemini-2.5-flash-image
# Per canvas mode (suffix = uppercase label, non-alphanumerics → underscore), e.g.:
# OPENROUTER_IMAGE_GEN_MODEL_FLUX_1=black-forest-labs/flux-1.1-pro
# OPENROUTER_IMAGE_GEN_MODEL_CLASSIC_FAST=black-forest-labs/flux-schnell
# OPENROUTER_IMAGE_GEN_MODEL_SDXL=stabilityai/stable-diffusion-xl-base-1.0
# Optional: OPENROUTER_IMAGE_GEN_MODALITIES=image,text  (or `image` for image-only models)
# Limit reference images per request (default 3) — large multimodal payloads can hit OpenRouter/Cloudflare worker limits (HTTP 503 / error 1102).
# OPENROUTER_IMAGE_GEN_MAX_ANCHORS=3

# --- Local perf (pnpm perf:lighthouse / perf:lighthouse:timespan) — optional ---
# Sign in before Lighthouse so metrics target the canvas (`/`) instead of `/signin`.
# Use the same host as BASE_URL (default http://localhost:4173/) — localhost vs 127.0.0.1 are different origins.
# PERF_AUTH_EMAIL=superadmin@example.com
# PERF_AUTH_PASSWORD=
