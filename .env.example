# Copy to .env — never commit real values.
# Dashboard: Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Anonymous (publishable) key — safe for browser apps. Do not use the service_role key here.
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_anon_key

# Storage: bucket name for Upload node (Supabase Dashboard → Storage). Public read + insert policies required for anon/auth.
VITE_SUPABASE_STORAGE_BUCKET=uploads

# Edge Function `scout-execute` (Supabase Dashboard → Edge Functions → scout-execute → Secrets). Not used by Vite directly.
# OPENROUTER_API_KEY=
# Stage 2 instructions (text prompt refinement): OPENROUTER_STAGE2_MODEL=google/gemini-2.0-flash-001
# Stage 2 image generator (OpenRouter image modalities): OPENROUTER_IMAGE_GEN_MODEL=google/gemini-2.5-flash-image
# Optional: OPENROUTER_IMAGE_GEN_MODALITIES=image,text  (or `image` for image-only models)
